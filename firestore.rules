rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId}/records/{recordId} {
      function owner() {
        return request.auth != null && request.auth.uid == userId;
      }
      function validEntry() {
        return request.resource.data.keys().hasOnly(['kind', 'cents', 'note', 'date', 'created', 'createdAt'])
          && request.resource.data.keys().hasAll(['kind', 'cents', 'note', 'date', 'created'])
          && request.resource.data.kind in ['income', 'expense']
          && request.resource.data.cents is int
          && request.resource.data.cents > 0
          && request.resource.data.cents <= 99999999900
          && request.resource.data.note is string
          && request.resource.data.note.size() > 0
          && request.resource.data.note.size() <= 200
          && request.resource.data.date is string
          && request.resource.data.date.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
          && request.resource.data.created is int;
      }
      allow get, list: if owner();
      allow create: if owner() && validEntry();
      allow update: if owner() && validEntry()
        && request.resource.data.created == resource.data.created;
      allow delete: if owner();
    }
  }
}